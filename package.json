{
  "name": "atropos",
  "version": "1.0.0",
  "private": true,
  "description": "Live Claude Code usage limits on the Windows desktop.",
  "main": "./out/main/index.js",
  "author": "YoanCuervo",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run --passWithNoTests",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config statusline.vite.config.mjs && vite build --config mod.vite.config.mjs",
    "icons": "electron scripts/generate-icons.mjs",
    "postinstall": "install-electron",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
